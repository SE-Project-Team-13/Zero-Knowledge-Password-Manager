{
  "name": "password-manager-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend/extension",
    "frontend/crypto-engine",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run crypto:build && npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "cd frontend && npm run lint",
    "extension:build": "npm run crypto:build && npm run build -w frontend/extension",
    "extension:watch": "npm run crypto:build && npm run watch -w frontend/extension",
    "crypto:build": "npm run build -w frontend/crypto-engine"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}